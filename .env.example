# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Docker container names
DB_CONTAINER=pengin-pi-3-db
WEB_CONTAINER=pengin-pi-3-web
REDIS_CONTAINER=pengin-pi-3-redis

# Database (Postgres, via docker-compose)
DB_NAME=
DB_USER=
DB_PASSWORD=

# FerretDB's DocumentDB extension (pg_cron) can only be installed into one
# specific database - this is that database's name, separate from DB_NAME
# above (docker-entrypoint-initdb/01-create-app-db.sh creates DB_NAME
# alongside it on first boot). Leave as 'postgres' unless you have a reason
# to change it.
FERRETDB_DB=postgres

# Domain(s) - used for ALLOWED_HOSTS and the Traefik routing labels in docker-compose.yml.
# NOTE: docker-compose.yml's traefik rule requests a certificate covering
# BOTH ${URL} and www.${URL} - if only the bare domain has a DNS record
# (no www CNAME/A record), Let's Encrypt's DNS validation will fail on the
# www name and NO certificate will be issued at all (traefik falls back to
# its default self-signed cert with no obvious error besides its logs).
# Either create both DNS records, or drop the "|| Host(`www.${URL}`)"
# clause from that rule for a single-domain deployment.
URL=
URL2=

# Only needed if you're using the bundled docker-compose.traefik.yml
# standalone reverse proxy (offered by deploy_fedora.sh /
# deploy_debian_ubuntu.sh / deploy_mac.sh when you don't already have your
# own Traefik/reverse proxy on this host) - Let's Encrypt requires a
# contact email for certificate issuance/renewal notices.
TRAEFIK_ACME_EMAIL=

# CSRF - comma-separated list of trusted origins, e.g. https://example.com,https://*.example.com
CSRF_TRUSTED_ORIGINS=

# Email (AWS SES) - optional. If SES_USERNAME_SMTP/SES_PASSWORD_SMTP/SES_SENDER
# are left blank, email sending is disabled and mail is printed to the
# console instead (no crash, nothing is actually delivered).
SES_HOST=email-smtp.us-west-2.amazonaws.com
SES_USERNAME_SMTP=
SES_PASSWORD_SMTP=
SES_SENDER=
SES_SENDER_NAME=
AWS_REGION=us-west-2

# File storage (AWS S3) - optional, only needed when FILE_STORAGE_BACKEND=s3.
# If S3_KEY/S3_SECRET/S3_BUCKET are left blank, FILE_STORAGE_BACKEND falls
# back to 'local' automatically even if set to 's3' below.
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_LOCATION=

# reCAPTCHA v3 (Google) - optional. If RECAPTCHA_SITE_KEY/RECAPTCHA_SECRET_KEY
# are left blank, reCAPTCHA is disabled: the widget is hidden and server-side
# verification is skipped instead of rejecting every submission.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# File storage: 'local' or 's3' (falls back to 'local' if S3 keys are missing)
FILE_STORAGE_BACKEND=local
